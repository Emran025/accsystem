{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "decision-record.schema.json",
  "type": "object",
  "required": [
    "id",
    "title",
    "status",
    "context",
    "problem",
    "alternatives",
    "decision",
    "rationale",
    "consequences",
    "affected_element_ids"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "status": {
      "enum": [
        "proposed",
        "accepted",
        "rejected",
        "superseded",
        "deprecated"
      ]
    },
    "context": {
      "type": "string"
    },
    "problem": {
      "type": "string"
    },
    "alternatives": {
      "type": "array"
    },
    "decision": {
      "type": "string"
    },
    "rationale": {
      "type": "string"
    },
    "consequences": {
      "type": "string"
    },
    "affected_element_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
